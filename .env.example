# Токен бота от @BotFather (обязательно)
MARKET_BOT_TOKEN=123456:ABC-DEF...

# 1 = демо-режим (не ходит в сеть) | 0 = реальные API маркетплейсов
MARKET_DEMO_MODE=1

# --- Антибот ---
# curl_cffi (имитация Chrome, по умолчанию) | httpx
MARKET_HTTP_CLIENT=curl_cffi
# Прокси с «чистым» IP: http://user:pass@host:port или socks5://host:1080
MARKET_PROXY=
MARKET_MAX_RETRIES=3

# --- Продвинутые настройки ---
# Проверка watch-подписок раз в N минут
MARKET_CHECK_INTERVAL_MINUTES=240
# Сколько результатов искать в каждом маркетплейсе
MARKET_MAX_RESULTS_PER_MARKET=5
# Кулдаун уведомлений по одной подписке (часы)
MARKET_ALERT_COOLDOWN_HOURS=12
# Хранить историю лучших цен N дней
MARKET_HISTORY_KEEP_DAYS=30
# Минимальный интервал между сообщениями пользователя (секунды)
MARKET_THROTTLE_MIN_INTERVAL=0.7
# ID администраторов для /cleanup (через запятую; пусто = доступно всем)
MARKET_ADMIN_IDS=
# TTL кэша поисковых выдач (секунды)
MARKET_CACHE_TTL_SECONDS=300
